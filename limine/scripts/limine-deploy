#!/usr/bin/env bash
# Deploy/sync the Limine boot menu: theme palette + wallpapers + font.
#
# Installed root-owned at /usr/local/bin/limine-deploy, invoked as root:
#   sudo limine-deploy            # sync config + current desktop wallpaper (fast, no args)
#   sudo limine-deploy --install  # (re)install font + wallpaper pack + config
#
# Safety: all inputs are validated. The theme must match a fixed table and the
# wallpaper must resolve inside the Hyprland wallpaper assets directory, so the
# passwordless sudoers rule for the no-argument form cannot be used to inject
# arbitrary config content or copy arbitrary files.
set -euo pipefail

[ "$(id -u)" -eq 0 ] || { echo "limine-deploy: must run as root" >&2; exit 1; }

ESP=/boot
EFI_DIR="$ESP/EFI/limine"
ASSET_DIR=/home/sacred/dotfiles/limine/assets
WALLPAPER_LINK=/home/sacred/.config/hypr/themes/wallpapers/current
THEME_STATE=/home/sacred/.cache/theme_state
ROOT_UUID=75fe80cc-5e74-4ff7-8d7a-2486a176e866

THEME="$(cat "$THEME_STATE" 2>/dev/null || true)"

case "$THEME" in
    obsidian) BG=0a0a0c; FG=e6e6e6; MUTED=8b8f98; SEL_BG=3a3f4b; SEL_FG=ffffff; ACCENT=ffffff ;;
    crimson)  BG=08080a; FG=e8e8e8; MUTED=8a8a8a; SEL_BG=ff2a3d; SEL_FG=ffffff; ACCENT=ff2a3d ;;
    aether)   BG=141820; FG=eaf2ff; MUTED=9aa6b2; SEL_BG=7aa2f7; SEL_FG=ffffff; ACCENT=7aa2f7 ;;
    ember)    BG=140e08; FG=e6d3b3; MUTED=a89984; SEL_BG=e0af68; SEL_FG=140e08; ACCENT=e0af68 ;;
    drift)    BG=12141a; FG=d6dbe3; MUTED=8f96a3; SEL_BG=c792ea; SEL_FG=12141a; ACCENT=7aa2a9 ;;
    windows)  BG=202226; FG=e6e6e6; MUTED=b3b3b3; SEL_BG=283f4d; SEL_FG=e6e6e6; ACCENT=4cc2ff ;;
    *)        echo "limine-deploy: unknown theme '${THEME:-<empty>}', using obsidian" >&2
              THEME=obsidian; BG=0a0a0c; FG=e6e6e6; MUTED=8b8f98; SEL_BG=3a3f4b; SEL_FG=ffffff; ACCENT=ffffff ;;
esac

render_config() {
    local conf w
    conf="$(mktemp)"
    {
        cat <<EOF
# Generated by limine-deploy -- do not edit (source: ~/dotfiles/limine)
timeout: 5
default_entry: 1
interface_resolution: 1920x1080
interface_branding: Arch Linux
interface_branding_color: $ACCENT
interface_help_hidden: yes
interface_help_color: $MUTED
interface_help_color_bright: $ACCENT
term_font: boot():/EFI/limine/font.f16
term_font_size: 8x16
term_font_scale: 2x2
term_font_spacing: 0
term_background: 66$BG
term_foreground: $FG
term_background_bright: $SEL_BG
term_foreground_bright: $SEL_FG
term_palette: $BG;ff6b6b;8fd694;ffd479;7aa2f7;c792ea;7ad7c7;$FG
term_palette_bright: $SEL_BG;ff8a8a;a8e6ac;ffe6a0;9ab8ff;d8b4f8;9ae6da;$SEL_FG
term_margin: 48
term_margin_gradient: 8
EOF
        for w in "$EFI_DIR"/w*.jpg; do
            [ -e "$w" ] || continue
            printf 'wallpaper: boot():/EFI/limine/%s\n' "$(basename "$w")"
        done
        cat <<EOF

/Arch Linux
    protocol: linux
    path: boot():/vmlinuz-linux
    cmdline: root=UUID=$ROOT_UUID rw loglevel=3 quiet
    module_path: boot():/initramfs-linux.img

/Windows
    protocol: efi
    path: boot(1):/EFI/Microsoft/Boot/bootmgfw.efi
EOF
    } > "$conf"
    install -m644 "$conf" "$ESP/limine.conf"
    rm -f "$conf"
    echo "limine-deploy: /boot/limine.conf written (theme: $THEME)"
}

sync_wallpaper() {
    local cur base tmp frame
    cur="$(readlink -f "$WALLPAPER_LINK" 2>/dev/null || true)"
    base="$(readlink -f /home/sacred/.config/hypr/themes/wallpapers/assets 2>/dev/null || true)"
    [ -n "$cur" ] && [ -n "$base" ] || return 0
    [[ "$cur" == "$base"/* && -f "$cur" ]] || {
        echo "limine-deploy: wallpaper outside asset dir, skipping" >&2
        return 0
    }
    tmp="$(mktemp --suffix=.jpg)"
    frame="$(mktemp --suffix=.png)"
    case "${cur,,}" in
        *.jpg|*.jpeg|*.png)
            magick "$cur" -auto-orient -resize '1920x1080^' -gravity center \
                -extent 1920x1080 -colorspace sRGB -modulate 75,100,100 \
                -blur 0x3 -quality 84 -strip "$tmp" ;;
        *.mp4)
            if ffmpeg -v error -y -ss 5 -i "$cur" -frames:v 1 \
                -vf "scale=1920:1080:force_original_aspect_ratio=increase,crop=1920:1080" \
                -q:v 2 "$frame"; then
                magick "$frame" -modulate 75,100,100 -blur 0x3 \
                    -quality 84 -strip "$tmp"
            else
                rm -f "$tmp" "$frame"
                return 0
            fi ;;
        *)
            rm -f "$tmp" "$frame"
            return 0 ;;
    esac
    install -m644 "$tmp" "$EFI_DIR/wcurrent.jpg"
    rm -f "$tmp" "$frame"
    echo "limine-deploy: current wallpaper -> wcurrent.jpg"
}

if [ "${1:-}" = "--install" ]; then
    install -d "$EFI_DIR"
    install -m644 "$ASSET_DIR/font/jetbrains-mono.f16" "$EFI_DIR/font.f16"
    for w in "$ASSET_DIR"/wallpapers/w*.jpg; do
        [ -e "$w" ] || continue
        install -m644 "$w" "$EFI_DIR/$(basename "$w")"
    done
    echo "limine-deploy: font and wallpaper pack installed"
elif [ -n "${1:-}" ]; then
    echo "limine-deploy: unknown argument '$1'" >&2
    exit 2
fi

sync_wallpaper
render_config
