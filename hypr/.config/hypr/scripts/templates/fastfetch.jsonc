{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "{{colors.primary.dark.hex}}"
    },
    "padding": {
      "left": 3,
      "right": 5,
      "top": 2
    }
  },
  "display": {
    "color": {
      "keys": "{{colors.primary.dark.hex}}",
      "separator": "{{colors.on_surface_variant.dark.hex}}",
      "title": "{{colors.on_surface.dark.hex}}"
    },
    "key": {
      "width": 9
    },
    "percent": {
      "color": {
        "green": "{{colors.tertiary.dark.hex}}",
        "red": "{{colors.error.dark.hex}}",
        "yellow": "{{colors.secondary.dark.hex}}"
      },
      "type": 9
    },
    "separator": "  "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;{{colors.primary.dark.red}};{{colors.primary.dark.green}};{{colors.primary.dark.blue}}m■\u001b[0m \u001b[38;2;{{colors.on_surface_variant.dark.red}};{{colors.on_surface_variant.dark.green}};{{colors.on_surface_variant.dark.blue}}m■ SacredArch · a hand-built Arch desktop\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{colors.primary.dark.red}};{{colors.primary.dark.green}};{{colors.primary.dark.blue}}m──\u001b[0m \u001b[1;38;2;{{colors.on_surface.dark.red}};{{colors.on_surface.dark.green}};{{colors.on_surface.dark.blue}}m── VITALS \u001b[0m \u001b[38;2;{{colors.outline_variant.dark.red}};{{colors.outline_variant.dark.green}};{{colors.outline_variant.dark.blue}}m──────────────────────────\u001b[0m \u001b[38;2;{{colors.outline_variant.dark.red}};{{colors.outline_variant.dark.green}};{{colors.outline_variant.dark.blue}}m────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": "MEMORY"
    },
    {
      "type": "disk",
      "key": "DISK"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{colors.primary.dark.red}};{{colors.primary.dark.green}};{{colors.primary.dark.blue}}m──\u001b[0m \u001b[1;38;2;{{colors.on_surface.dark.red}};{{colors.on_surface.dark.green}};{{colors.on_surface.dark.blue}}m── SYSTEM \u001b[0m \u001b[38;2;{{colors.outline_variant.dark.red}};{{colors.outline_variant.dark.green}};{{colors.outline_variant.dark.blue}}m──────────────────────────\u001b[0m \u001b[38;2;{{colors.outline_variant.dark.red}};{{colors.outline_variant.dark.green}};{{colors.outline_variant.dark.blue}}m────\u001b[0m"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "shell",
      "key": "SHELL"
    },
    {
      "type": "packages",
      "key": "PKGS"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;{{colors.primary.dark.red}};{{colors.primary.dark.green}};{{colors.primary.dark.blue}}m──\u001b[0m \u001b[1;38;2;{{colors.on_surface.dark.red}};{{colors.on_surface.dark.green}};{{colors.on_surface.dark.blue}}m── SESSION \u001b[0m \u001b[38;2;{{colors.outline_variant.dark.red}};{{colors.outline_variant.dark.green}};{{colors.outline_variant.dark.blue}}m─────────────────────────\u001b[0m \u001b[38;2;{{colors.outline_variant.dark.red}};{{colors.outline_variant.dark.green}};{{colors.outline_variant.dark.blue}}m────\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },
    {
      "type": "terminal",
      "key": "TERM"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
